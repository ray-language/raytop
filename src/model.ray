// raytop — view state: sort mode, filter, scroll; pure over a Snapshot.
import sample;

pub enum SortBy {
    Cpu,
    Mem,
    Pid,
}

pub struct Model {
    sort: SortBy,
    filter: string,
    typing_filter: bool,
    scroll: int,
    selected: int,
}

pub fn new_model() -> Model {
    Model { sort: SortBy.Cpu, filter: "", typing_filter: false, scroll: 0, selected: 0 }
}

// Strict "a goes before b" for the given sort mode: CPU and MEM descending,
// ties (and the Pid mode) by ascending PID. sort_by is stable, so equal keys
// keep their sampling order.
fn before(a: sample.Proc, b: sample.Proc, s: SortBy) -> bool {
    match (s) {
        SortBy.Cpu => {
            if (a.cpu != b.cpu) {
                return a.cpu > b.cpu;
            }
            a.pid < b.pid
        },
        SortBy.Mem => {
            if (a.rss_kb != b.rss_kb) {
                return a.rss_kb > b.rss_kb;
            }
            a.pid < b.pid
        },
        SortBy.Pid => a.pid < b.pid,
    }
}

fn sort_procs(xs: [sample.Proc], s: SortBy) -> [sample.Proc] {
    sort_by(xs, fn(a: sample.Proc, b: sample.Proc) -> bool { before(a, b, s) })
}

fn matches(p: sample.Proc, needle: string) -> bool {
    if (needle == "") {
        return true;
    }
    let n = needle.to_lower();
    p.command.to_lower().contains(n)
        || p.user.to_lower().contains(n)
        || to_string(p.pid).contains(n)
}

// The rows the table shows, filtered then sorted.
pub fn visible(snap: sample.Snapshot, m: Model) -> [sample.Proc] {
    var kept: [sample.Proc] = [];
    for p in snap.procs {
        if (matches(p, m.filter)) {
            kept.push(p);
        }
    }
    sort_procs(kept, m.sort)
}

// Clamps scroll/selection to the current row count and window height.
pub fn clamp(m: Model, total: int, page: int) {
    if (m.selected >= total) {
        m.selected = total - 1;
    }
    if (m.selected < 0) {
        m.selected = 0;
    }
    if (m.selected < m.scroll) {
        m.scroll = m.selected;
    }
    if (page > 0 && m.selected >= m.scroll + page) {
        m.scroll = m.selected - page + 1;
    }
    if (m.scroll < 0) {
        m.scroll = 0;
    }
}
